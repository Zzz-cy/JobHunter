# ========== 智谱AI (Zhipu) 主力配置 ==========
# 智谱AI API Key
# 获取地址: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=your-zhipu-api-key.xxxxxxxx
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# 默认模型（根据任务类型自动选择，以下为各场景默认）
# - 意图识别: glm-4-flash（轻量快速）
# - 日常问答: glm-4-air（平衡）
# - 知识抽取: glm-4（高精度）
# - 报告生成: glm-4-plus（最强能力）
# - 长文本: glm-4-long（长上下文）
ZHIPU_MODEL=glm-4-flash
ZHIPU_TEMPERATURE=0.3
ZHIPU_MAX_TOKENS=4096

# ========== 备选模型配置（降级用） ==========
# DeepSeek
 DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
 DEEPSEEK_API_BASE=https://api.deepseek.com/v1
 DEEPSEEK_MODEL=deepseek-chat

# Kimi (Moonshot)
KIMI_API_KEY=sk-your-kimi-api-key-here
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# 通义千问 (DashScope)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-turbo

# 讯飞星火（特殊HMAC认证）
XFYUN_APPID=your-xfyun-appid
XFYUN_APIKEY=your-xfyun-apikey
XFYUN_APISECRET=your-xfyun-apisecret

# ========== 数据库配置 ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=1
MYSQL_PASSWORD=root1234
MYSQL_DATABASE=model

# ========== Neo4j 图数据库 ==========
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ========== Elasticsearch ==========
ES_HOST=http://localhost:9200
ES_INDEX=job_competency

# ========== 向量数据库 ==========
VECTOR_DB_PATH=./data/vector_db

# ========== 服务配置 ==========
HOST=0.0.0.0
PORT=5173
DEBUG=true

# ========== 日志配置 ==========
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志格式: "text" (默认) 或 "json" (结构化JSON日志)
LOG_FORMAT=text
# 慢请求阈值（秒），超过此值的请求自动记录WARNING
SLOW_REQUEST_THRESHOLD=10.0
# 单个日志文件最大字节数（默认10MB）
# LOG_MAX_BYTES=10485760
# 日志文件备份数量（默认5）
# LOG_BACKUP_COUNT=5

# ========== 限流与并发 ==========
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
MAX_CONCURRENT_AGENTS=5

# ========== 安全配置 ==========
# CORS白名单，多个用逗号分隔，* 表示允许所有来源（仅开发环境）
CORS_ORIGINS=*
# 安全头开关
SECURITY_HEADERS_ENABLED=true

# ========== Alembic 数据库迁移 ==========
# 如不设置，alembic会自动检测MySQL/SQLite
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/job_competency
